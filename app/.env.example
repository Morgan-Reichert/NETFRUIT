# NETFRUIT generation agent — copy this file to `.env` and fill in your keys.
# The agent loads app/.env automatically. Keys stay on your machine and never
# reach the browser or this chat.

# ─────────────────────────────────────────────────────────────────────────────
# PREMIUM STACK — one fal.ai key powers EVERYTHING (script, images, voices, video)
# Get your key at: https://fal.ai/dashboard/keys   (pay-as-you-go credits)
# ─────────────────────────────────────────────────────────────────────────────
FAL_KEY=

# When FAL_KEY is set, the pipeline auto-routes to fal:
#   script  → openai/gpt-4o via fal-ai/any-llm
#   images  → fal-ai/flux/dev (Pixar-style fruit mascots with faces)
#   voices  → fal-ai/elevenlabs/tts/multilingual-v2 (distinct voice per actor, FR/EN/ES)
#   video   → fal-ai/kling-video (talking, gesturing, moving fruit)  + optional lip-sync
#
# Overrides (all optional):
# NETFRUIT_VIDEO=fal-kling        # fal-kling | fal-ltx | fal-talk | mock
# NETFRUIT_FAL_TEXT=openai/gpt-4o # or google/gemini-flash-1.5, etc.
# NETFRUIT_FAL_KLING=fal-ai/kling-video/v1.6/standard/image-to-video
# NETFRUIT_LIPSYNC=1              # 1 = attempt real phoneme lip-sync (falls back to Kling)
# NETFRUIT_LIPSYNC_LANGS=fr       # language the lip-sync is timed to
# NETFRUIT_SHOTS=8               # scenes per episode (each = 1 fal video clip)

# ─────────────────────────────────────────────────────────────────────────────
# AUTH — Supabase (front-end). These are VITE_ vars: public by design (the anon
# key is safe to ship; row-level security protects data). Add the SAME two vars
# in your Vercel project settings so auth works in production.
#   Supabase dashboard → Project Settings → API
# ─────────────────────────────────────────────────────────────────────────────
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# FREE / alternative stack (no fal key)
#   images → Pollinations (free, no key) · script+voice → Gemini free tier
# ─────────────────────────────────────────────────────────────────────────────
# GEMINI_API_KEY=                # https://aistudio.google.com/apikey (script + voice free)
# NETFRUIT_IMAGE=pollinations    # free images, no key
# ANTHROPIC_API_KEY=             # scripts via Claude (paid)
# ELEVENLABS_API_KEY=            # direct ElevenLabs (alt to fal)
