# NETFRUIT generation agent — copy this file to `.env` and fill in your keys.
# The agent loads app/.env automatically. Keys stay on your machine and never
# reach the browser or this chat.

# ─────────────────────────────────────────────────────────────────────────────
# RECOMMENDED FREE STACK
#   • script + voice → Gemini (free tier) with the key below
#   • images         → Pollinations (free, no key) — Gemini image gen needs billing
# Get a free key (no billing) at: https://aistudio.google.com/apikey
# ─────────────────────────────────────────────────────────────────────────────
GEMINI_API_KEY=

# With the key set, script+voice auto-select Gemini and images use Pollinations.
# Overrides:
# NETFRUIT_IMAGE=pollinations  # pollinations (free) | gemini (needs billing) | fal-flux | mock
# NETFRUIT_VOICE=gemini        # gemini | elevenlabs | openai | mock
# NETFRUIT_LLM=gemini          # gemini | anthropic | mock
# NETFRUIT_GEMINI_VOICE=Kore   # Kore, Puck, Charon, Fenrir, Aoede… (TTS voices)

# ─────────────────────────────────────────────────────────────────────────────
# OPTIONAL alternatives
# ─────────────────────────────────────────────────────────────────────────────
# ANTHROPIC_API_KEY=           # scripts via Claude (paid)
# ELEVENLABS_API_KEY=          # premium voice, free tier ~10k chars/mo
# ELEVENLABS_VOICE_ID=Rachel
# FAL_KEY=                     # cheap Flux images + LTX video (~cents)
# OPENAI_API_KEY=              # tts-1 voice (paid)

# ─────────────────────────────────────────────────────────────────────────────
# Tuning
# ─────────────────────────────────────────────────────────────────────────────
# NETFRUIT_SHOTS=5             # shots (scenes) per episode
