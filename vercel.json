{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm --prefix app install",
  "buildCommand": "npm --prefix app run build",
  "outputDirectory": "app/dist",
  "framework": null,
  "rewrites": [
    { "source": "/studio", "destination": "/index.html" },
    { "source": "/studio/:path*", "destination": "/index.html" },
    { "source": "/c/:path*", "destination": "/index.html" },
    { "source": "/reset-password", "destination": "/index.html" }
  ]
}
